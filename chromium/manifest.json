{
  "manifest_version": 3,
  "name": "Tab Share",
  "version": "2.12",
  "description": "Share and manage tabs via local HTTP API",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "scripting", "alarms", "webRequest", "webRequestAuthProvider", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://127.0.0.1/*", "http://localhost/*", "https://yoavdim.github.io/*"],
      "js": ["content.js"],
      "all_frames": false
    },
    {
      "matches": ["file:///*", "http://127.0.0.1/*", "http://localhost/*", "https://yoavdim.github.io/*"],
      "js": ["tabshare_page.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://yoavdim.github.io/TabTimer/*", "https://yoavdim.github.io/TabTimer"],
      "js": ["tabtimer.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["policy.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
