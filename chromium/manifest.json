{
  "manifest_version": 3,
  "name": "Tab Share (Chromium)",
  "version": "2.10",
  "description": "Share and manage tabs via local HTTP API",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
