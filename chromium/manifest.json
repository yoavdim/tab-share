{
  "manifest_version": 3,
  "name": "Tab Share (Chromium)",
  "version": "2.12",
  "description": "Share and manage tabs via local HTTP API",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "scripting", "alarms", "webRequest", "webRequestAuthProvider", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://127.0.0.1/*", "http://localhost/*", "https://yoavdim.github.io/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
